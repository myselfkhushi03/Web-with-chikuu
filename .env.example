# --- required ---
BOT_TOKEN=
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# --- recommended ---
ADMIN_IDS=123456789            # comma separated Telegram user IDs
# RENDER_EXTERNAL_URL is set automatically by Render; set it yourself for other hosts
# RENDER_EXTERNAL_URL=https://your-app.onrender.com

# --- optional ---
DB_NAME=webify_bot
DATA_DIR=./data                # on Render with a disk: /var/data
USE_WEBHOOK=true               # false = long polling
KEEP_ALIVE=true                # self-ping /health so free instances don't sleep
# WILDCARD_DOMAIN=sites.example.com
# WEBHOOK_SECRET=any-random-string